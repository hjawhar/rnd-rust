# Database
DATABASE_URL="postgres://sts_user:your_password@localhost:5470/sts_db"

# Encryption
AES256_GCM_KEY="your_aes256_gcm_key_hex"
ED25519_KEY="your_ed25519_key_hex"

# Axsys (Twitter feed)
AXSYS_API_KEY="your_axsys_api_key"
AXSYS_API_KEY_NORMAL="your_axsys_api_key_normal"
AXSYS_WS_ENDPOINT="wss://twitter-api.axsys.us/v1/events"
AXSYS_EXTERNAL_API_KEY="your_axsys_external_api_key"

# Solana RPC
GPA_ENDPOINT="your_gpa_rpc_endpoint"
RPC_ENDPOINT="your_rpc_endpoint"
GEYSER_ENDPOINT="your_geyser_endpoint"
GEYSER_TOKEN="your_geyser_token"

# Jupiter
JUPITER_ENDPOINT="https://api.jup.ag/swap/v1"
JUPITER_API_KEY="your_jupiter_api_key"

# Nextblock
NEXTBLOCK_ENDPOINT="https://fra.nextblock.io/api/v2/submit"
NEXTBLOCK_API_KEY="your_nextblock_api_key"

# Zero Slot
ZERO_SLOT_ENDPOINT="your_zero_slot_endpoint"

# Jito
JITO_API_ENDPOINT="https://frankfurt.mainnet.block-engine.jito.wtf/api/v1"
JITO_API_KEY="your_jito_api_key"
JITO_AUTH_KEYPAIR="your_jito_auth_keypair_bs58"

# OCR Service
OCR_API_ENDPOINT="http://localhost:6999/ocr"

# Bloxroute
BLOXROUTE_API_ENDPOINT_SOL="https://germany.solana.dex.blxrbdn.com/api/v2/submit"
BLOXROUTE_API_KEY="your_bloxroute_api_key"

# Server Config
SERVER_NAME="LOCAL"
SERVER_IP="ws://localhost:3001/ws"
X_API_KEY="your_x_api_key"

# Multi-server (comma-separated: IP@NAME)
SERVERS="127.0.0.1@LOCAL"
BLOCK_LEADERS="JITO,NEXTBLOCK,BLOXROUTE,ZERO_SLOT"

# Pushover Alerts
PUSHOVER_APP_TOKEN="your_pushover_app_token"
PUSHOVER_USER_KEYS="your_pushover_user_key_1,your_pushover_user_key_2"

# Durable Nonce (optional)
NONCE_ACCOUNT_KEY="your_nonce_account_bs58_key"
NONCE_AUTHORITY_PUBKEY="your_nonce_authority_pubkey"
