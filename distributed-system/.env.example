# Infrastructure (docker-compose)
POSTGRES_USER=distributed
POSTGRES_PASSWORD=distributed
POSTGRES_DB=aggregator
GRAFANA_ADMIN_PASSWORD=admin

# Services (Rust binaries via clap)
NATS_URL=nats://localhost:4222
GATEWAY_ADDR=0.0.0.0:3000
AGGREGATOR_ADDR=0.0.0.0:3001
DATABASE_URL=postgres://distributed:distributed@localhost:5432/aggregator

# Processor
METRICS_ADDR=0.0.0.0:9091
PROCESSOR_ID=
PROCESSING_DELAY_MS=50
ENRICH_TIMEOUT_MS=2000

# Enricher
# METRICS_ADDR=0.0.0.0:9090  # (enricher default; conflicts with processor if both use same value)
ENRICH_DELAY_MS=10

# Tracing (set to enable OTLP export)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Container registry (scripts/build-images.sh, scripts/deploy.sh)
REGISTRY=localhost:5111
