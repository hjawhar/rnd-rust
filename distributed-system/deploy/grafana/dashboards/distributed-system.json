{
  "dashboard": {
    "id": null,
    "uid": "distributed-system",
    "title": "Distributed System Overview",
    "tags": ["distributed-system"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "5s",
    "time": { "from": "now-5m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Gateway Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(http_requests_total{app=\"gateway\"}[1m])",
            "legendFormat": "{{method}} {{path}} {{status}}",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 2,
        "title": "Gateway Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "fieldConfig": {
          "defaults": { "unit": "s" }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{app=\"gateway\"}[1m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{app=\"gateway\"}[1m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{app=\"gateway\"}[1m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 3,
        "title": "NATS Messages (pub / recv)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(nats_messages_published_total[1m])",
            "legendFormat": "published {{subject}}",
            "refId": "A"
          },
          {
            "expr": "rate(nats_messages_received_total[1m])",
            "legendFormat": "received {{subject}}",
            "refId": "B"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 4,
        "title": "Processing Duration (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": {
          "defaults": { "unit": "s" }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(processing_duration_seconds_bucket[1m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(processing_duration_seconds_bucket[1m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(processing_duration_seconds_bucket[1m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 5,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(http_requests_total{status!~\"2..\"}[1m])",
            "legendFormat": "{{app}} {{status}}",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 6,
        "title": "Enrichment Requests",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(nats_messages_received_total{subject=\"enrich.request\"}[1m])",
            "legendFormat": "enrich requests/s",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      }
    ]
  }
}
