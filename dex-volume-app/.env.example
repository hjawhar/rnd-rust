# =============================================================================
# Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# Use .env.{APP_ENV} for environment-specific overrides (e.g. .env.production).
# Load order: .env.{APP_ENV} first, then .env (vars not already set).
# APP_ENV should be set in the real environment (shell, Docker), not in .env.
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
APP_ENV=development                     # development | production | staging
LOG_LEVEL=                              # debug | info | warn | error (default: per APP_ENV)

# ── Docker Infrastructure Credentials ────────────────────────────────────────
# Required when running via docker-compose. Generate strong random values.
POSTGRES_USER=vm_user                   # Default: vm_user
POSTGRES_DB=vm_db                       # Default: vm_db
POSTGRES_PASSWORD=                      # REQUIRED for docker-compose (postgres)
REDIS_PASSWORD=                         # REQUIRED for docker-compose (redis)

# ── Database ─────────────────────────────────────────────────────────────────
# Inside docker-compose, this is built automatically from POSTGRES_* above.
# For local dev without docker, set directly:
DATABASE_URL=postgresql://vm_user:PASSWORD@localhost:5433/vm_db
DATABASE_READ_URL=                      # Optional read replica URL (api-server only). Falls back to DATABASE_URL if unset.
DB_POOL_SIZE=                           # Default: api-server dev=5/prod=10, workers dev=3/prod=5

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_SUBSCRIPTION_CAPACITY=             # Per-subscription message buffer (default: 8192)
NATS_READ_BUFFER_CAPACITY=              # Client read buffer in KiB, u16 (optional)

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:PASSWORD@localhost:6379
REDIS_POOL_SIZE=                        # Number of TCP connections (default: 8)

# ── Tokio Runtime ─────────────────────────────────────────────────────────────
TOKIO_WORKER_THREADS=                   # Async runtime threads (default: CPU cores)

# ── Security ─────────────────────────────────────────────────────────────
# Generate both with: ./scripts/vm.sh genkeys
# DO NOT regenerate after deployment — rotating these causes data loss / logouts:
#   AES256_GCM_KEY change → existing encrypted wallets become unreadable (DATA LOSS)
#   ED25519_KEY   change → all active JWTs invalidated (users logged out)
AES256_GCM_KEY=                         # 256-bit key for wallet AES-256-GCM encryption (64 hex chars)
ED25519_KEY=                            # Ed25519 keypair for JWT signing (PKCS8 DER, hex-encoded)

# ── API Server ───────────────────────────────────────────────────────────────
PORT=3000                               # HTTP server port
MAX_CONCURRENT_HANDLERS=                # Default: dev=50, prod=200
DISCORD_TOKEN=                          # Discord bot token for notifications
API_KEY=                                # API authentication key
ADMIN_ADDRESS=                          # Optional: wallet address to seed as admin on first startup

# ── Worker (Solana) ──────────────────────────────────────────────────────────
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
GPA_ENDPOINT=                           # getProgramAccounts RPC endpoint
WORKER_ID=                              # Auto-generated UUID if unset
WORKER_QUEUE_GROUP=workers              # NATS queue group
JITO_API_ENDPOINT=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_API_KEY=
ZERO_SLOT_ENDPOINT=
BUNDLE_SIMULATION_RPC=                  # QuickNode endpoint for simulateBundle (optional, skips simulation if unset)

# ── Worker (EVM) ─────────────────────────────────────────────────────────────
ETH_HTTP=                               # Ethereum RPC endpoint
BASE_HTTP=                              # Base RPC endpoint
BSC_HTTP=                               # BSC RPC endpoint (optional)
ARB_HTTP=                               # Arbitrum RPC endpoint (optional)
AVAX_HTTP=                              # Avalanche RPC endpoint (optional)
# WORKER_ID, WORKER_QUEUE_GROUP — same vars as Solana worker
# Default WORKER_QUEUE_GROUP for EVM worker: workers-evm

# ── Geyser Relay ─────────────────────────────────────────────────────────────
GEYSER_ENDPOINT=                        # Yellowstone gRPC endpoint
GEYSER_TOKEN=                           # Geyser API token
RELAY_ID=                               # Auto-generated UUID if unset
